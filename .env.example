# Secrets live in environment-specific Rails credentials, not .env.
# Edit with:
#   bin/rails credentials:edit --environment development
#   bin/rails credentials:edit --environment test
#   bin/rails credentials:edit --environment production
#
# Required keys (per environment file):
#   openrouter.api_key
#   buttondown.api_key
#   admin.username / admin.password
#   app.host
#
# Optional:
#   digitalnz.api_key          # public API works without; header auth if set
#   buttondown.subscribe_url
#   instagram.access_token     # Instagram skipped when blank
#   instagram.user_id
#   admin.alert_email
#   app.harvest_pipeline_target
#   smtp.*
#
# Keys:
#   config/credentials/development.key  — gitignored; keep locally
#   config/credentials/test.key         — committed for CI
#   config/credentials/production.key   — gitignored; set RAILS_MASTER_KEY on the host
#
# Non-secret process env still fine here if you use dotenv:
# PORT=3000
# RAILS_MAX_THREADS=5
# SOLID_QUEUE_IN_PUMA=true
# RAILS_LOG_LEVEL=info
#
# SQLite files live under storage/ (no DATABASE_URL / DB password required).
