<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Aotearoa, Again" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#f3efe6">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Daily photographs from the Alexander Turnbull Library, seen again in colour." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="alternate" type="application/atom+xml" title="Aotearoa, Again" href="<%= feed_path %>">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,700&family=Source+Sans+3:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="aa-body">
    <header class="aa-header">
      <div class="aa-header-inner">
        <a href="<%= root_path %>" class="aa-brand">
          <span class="aa-brand-name">Aotearoa, Again</span>
          <span class="aa-brand-tagline">Daily photographs from the Alexander Turnbull Library, seen again in colour.</span>
        </a>
        <nav class="aa-nav">
          <%= link_to "Archive", editions_path %>
          <%= link_to "About", about_path %>
          <%= link_to "Feed", feed_path %>
          <%= link_to "Subscribe", subscribe_path %>
          <%= social_nav_icon_link(AppConfig.instagram_url, "fa-instagram", "Instagram") %>
          <%= social_nav_icon_link(AppConfig.facebook_url, "fa-facebook", "Facebook") %>
        </nav>
      </div>
    </header>
    <main>
      <%= yield %>
    </main>
    <footer class="aa-footer">
      <p>
        Photographs courtesy of the Alexander Turnbull Library, via DigitalNZ. AI colourised — colours are interpretive.
        <span aria-hidden="true"> · </span><%= link_to "About", about_path, class: "aa-footer-link" %>
      </p>
    </footer>
  </body>
</html>
