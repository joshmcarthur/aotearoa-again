<% source = @edition.source_item %>
<% variant = @edition.variant %>
<% candidate = @edition.candidate %>

<div class="mb-6">
  <%= link_to "← Editions", admin_editions_path, class: "text-sm text-stone-600 hover:underline" %>
  <h1 class="mt-2 text-2xl font-semibold"><%= source.title %></h1>
  <p class="text-sm text-stone-600">
    <%= [
      @edition.publish_on,
      @edition.state,
      variant.model.model_id
    ].compact.join(" · ") %>
  </p>
  <p class="mt-2 text-sm">
    <%= link_to "Public edition", edition_path(@edition), class: "underline" %>
    <% if variant.share_link.present? %>
      · Short link:
      <%= link_to variant.share_link.url, share_link_path(variant.share_link.code), class: "underline", target: "_blank", rel: "noopener" %>
    <% end %>
  </p>
</div>

<div class="grid gap-6 md:grid-cols-2">
  <div class="rounded border border-stone-300 bg-white p-3">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Original</h2>
    <% if candidate.original_image.attached? %>
      <%= image_tag candidate.original_image, class: "w-full" %>
    <% else %>
      <p class="text-sm text-stone-500">Not available yet</p>
    <% end %>
  </div>

  <div class="rounded border border-stone-300 bg-white p-3">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Colourised</h2>
    <% if variant.colourised_image.attached? %>
      <%= image_tag variant.colourised_image, class: "w-full" %>
    <% else %>
      <p class="text-sm text-stone-500">Not available yet</p>
    <% end %>
  </div>

  <div class="rounded border border-stone-300 bg-white p-3">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Share (unbranded)</h2>
    <% if variant.composite_image.attached? %>
      <%= image_tag variant.composite_image, class: "w-full" %>
    <% else %>
      <p class="text-sm text-stone-500">Not available yet</p>
    <% end %>
  </div>

  <div class="rounded border border-stone-300 bg-white p-3">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Branded</h2>
    <% if variant.share_image.attached? %>
      <%= image_tag variant.share_image, class: "w-full" %>
    <% else %>
      <p class="text-sm text-stone-500">Not available yet</p>
    <% end %>
    <% if variant.share_link.present? %>
      <p class="mt-2 text-xs text-stone-500">
        QR target:
        <%= link_to variant.share_link.url, share_link_path(variant.share_link.code), class: "underline", target: "_blank", rel: "noopener" %>
      </p>
    <% end %>
  </div>
</div>

<div class="mt-6 rounded border border-stone-300 bg-white p-3">
  <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Share video</h2>
  <% if variant.share_video.attached? %>
    <video controls class="mx-auto max-h-[70vh] w-full max-w-sm" preload="metadata">
      <source src="<%= url_for(variant.share_video) %>" type="<%= variant.share_video.content_type %>">
    </video>
    <% if @edition.state.in?(%w[scheduled published]) %>
      <p class="mt-2 text-xs text-stone-500">
        Public URL:
        <%= link_to edition_share_video_path(@edition), edition_share_video_path(@edition), class: "underline", target: "_blank", rel: "noopener" %>
      </p>
    <% end %>
  <% else %>
    <p class="text-sm text-stone-500">Not available yet</p>
  <% end %>
</div>

<div class="mt-8 border-t border-stone-300 pt-6">
  <%= button_to "Regenerate", regenerate_admin_edition_path(@edition), class: "rounded bg-stone-900 px-3 py-2 text-sm text-white" %>
  <p class="mt-2 text-xs text-stone-500">Re-composes share images and video from the current colourised image.</p>
</div>
