<% source = @candidate.source_item %>
<div class="mb-6">
  <%= link_to "← Queue", admin_candidates_path, class: "text-sm text-stone-600 hover:underline" %>
  <div class="mt-2 flex flex-wrap items-center gap-2">
    <h1 class="text-2xl font-semibold"><%= source.title %></h1>
    <span class="rounded border px-2 py-0.5 text-xs font-medium <%= candidate_review_status_classes(@review_history.status) %>">
      <%= @review_history.status_label %>
    </span>
    <% if source.meta_upload_eligible? %>
      <span class="rounded border border-sky-400 bg-sky-50 px-2 py-0.5 text-xs font-medium text-sky-900">Meta upload eligible</span>
    <% else %>
      <span class="rounded border border-amber-400 bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-900">Not Meta upload eligible</span>
    <% end %>
  </div>
  <p class="text-sm text-stone-600"><%= [source.display_date, source.placename, source.creator].compact.join(" · ") %></p>
  <p class="mt-2 max-w-3xl text-sm"><%= source.description %></p>
  <p class="mt-2 text-sm">
    Rights: <%= source.rights_text %> ·
    <%= link_to "Library record", source.record_url, target: "_blank", rel: "noopener", class: "underline" %>
  </p>
  <p class="mt-3 max-w-3xl rounded border border-stone-300 bg-stone-50 px-3 py-2 text-sm text-stone-700">
    <strong>People / tikanga:</strong> If people are visible, approve only when overlays respect dignity and mana
    (avoid cropping or blending through faces). Seek community advice if unsure.
  </p>
</div>

<div class="mb-8 rounded border border-stone-300 bg-white p-4">
  <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide">History</h2>
  <ol class="space-y-2 text-sm">
    <% @review_history.events.each do |event| %>
      <li class="flex flex-wrap gap-x-2 gap-y-1">
        <time class="shrink-0 text-stone-500" datetime="<%= event.at.iso8601 %>"><%= l(event.at, format: :short) %></time>
        <span class="font-medium"><%= event.label %></span>
        <% if event.detail.present? %>
          <span class="text-stone-600">— <%= event.detail %></span>
        <% end %>
      </li>
    <% end %>
  </ol>
</div>

<div class="grid gap-6 md:grid-cols-2">
  <div class="rounded border border-stone-300 bg-white p-3">
    <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">Original</h2>
    <% if @candidate.original_image.attached? %>
      <%= image_tag @candidate.original_image, class: "w-full" %>
    <% end %>
  </div>

  <% @variants.each do |variant| %>
    <div class="rounded border p-3 <%= variant.chosen? ? "border-emerald-500 bg-emerald-50/40" : "border-stone-300 bg-white" %>">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide">
        Colourised · <%= variant.model.name %>
        <span class="font-normal text-stone-500">(<%= variant.model.model_id %>)</span>
        <% if variant.chosen? %>
          <span class="ml-1 rounded border border-emerald-400 bg-emerald-100 px-1.5 py-0.5 text-xs font-medium normal-case text-emerald-900">Chosen</span>
        <% end %>
      </h2>
      <% if variant.colourised_image.attached? %>
        <%= image_tag variant.colourised_image, class: "w-full" %>
      <% end %>
      <% if variant.edition.present? %>
        <p class="mt-2 text-xs text-stone-600">
          Edition:
          <%= link_to variant.edition.publish_on, admin_edition_path(variant.edition), class: "underline" %>
          (<%= variant.edition.state %>)
        </p>
      <% end %>
      <div class="mt-3 flex flex-wrap gap-2">
        <%= button_to "Approve this variant", approve_admin_candidate_path(@candidate), params: { variant_id: variant.id }, class: "rounded bg-emerald-800 px-3 py-2 text-sm text-white" %>
      </div>
    </div>
  <% end %>
</div>

<div class="mt-8 flex flex-wrap gap-4 border-t border-stone-300 pt-6">
  <%= button_to "Reject", reject_admin_candidate_path(@candidate), params: { reason: "Not suitable" }, class: "rounded border border-red-700 px-3 py-2 text-sm text-red-800" %>

  <%= form_with url: regenerate_admin_candidate_path(@candidate), method: :post, class: "flex flex-wrap items-end gap-2" do %>
    <div>
      <label class="block text-xs font-semibold uppercase">Regenerate with model</label>
      <select name="model_id" class="rounded border border-stone-400 px-2 py-1 text-sm">
        <option value="">Preferred set</option>
        <% Model.openrouter.image_capable.order(:name).each do |model| %>
          <option value="<%= model.id %>"><%= model.name %> (<%= model.model_id %>)</option>
        <% end %>
      </select>
    </div>
    <button class="rounded bg-stone-900 px-3 py-2 text-sm text-white">Regenerate colour</button>
  <% end %>
</div>
