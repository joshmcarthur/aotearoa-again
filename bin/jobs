#!/usr/bin/env sh
set -e

# Always run from the app root so config/environment resolves.
APP_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$APP_ROOT"
export APP_ROOT

# macOS: OBJC fork-safety must be set *before* Ruby starts (setting ENV in Ruby is too late).
# libvips text/fonts initialize CoreText/UIFont; Solid Queue's default fork mode then crashes.
# Prefer async supervisor mode locally so workers run in-process on threads instead of fork().
if [ "$(uname -s)" = "Darwin" ]; then
  export OBJC_DISABLE_INITIALIZE_FORK_SAFETY="${OBJC_DISABLE_INITIALIZE_FORK_SAFETY:-YES}"
  export SOLID_QUEUE_SUPERVISOR_MODE="${SOLID_QUEUE_SUPERVISOR_MODE:-async}"
fi

exec ruby -e '
  Dir.chdir(ENV.fetch("APP_ROOT"))
  require File.join(ENV.fetch("APP_ROOT"), "config/environment")
  require "solid_queue/cli"
  SolidQueue::Cli.start(ARGV)
' -- "$@"
